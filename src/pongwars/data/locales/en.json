  "howto.nav": "Left/Right page  Esc back",
  "howto.1.title": "Goal",
  "howto.1.line1": "Bounce the ball past your rivals.",
  "howto.1.line2": "Miss it and the other side scores.",
  "howto.1.line3": "Play 2, 3 or 4 player arenas,",
  "howto.1.line4": "alone vs AI or with friends.",
  "howto.2.title": "Controls",
  "howto.2.line1": "P1: W/S move, A spin, D fire",
  "howto.2.line2": "P2: Up/Down, Right spin, Left fire",
  "howto.2.line3": "P3: J/L move, H spin, K fire",
  "howto.2.line4": "P4: KP8/2 move, KP4 spin, KP5 fire",
  "howto.2.line5": "Spin on hit while moving slows ball.",
  "howto.2.line6": "Esc pauses. Move keys in Settings.",
  "howto.3.title": "Modes",
  "howto.3.line1": "Classic: first to the points wins.",
  "howto.3.line2": "Timed: most points when time ends.",
  "howto.3.line3": "Survival: last with lives wins.",
  "howto.3.line4": "King: score only while ruling.",
  "howto.4.title": "Powers",
  "howto.4.line1": "Walk over a pickup to get it.",
  "howto.4.line2": "BIG FAST MAG SHLD MULTI SLOW",
  "howto.4.line3": "AIM CLEAN SLOWB help you.",
  "howto.4.line4": "Powers last a few seconds.",
  "howto.4.line5": "ALLY adds a mini AI defender.",
  "howto.4.line6": "Big leads trigger short pickups.",
  "howto.5.title": "Weapons",
  "howto.5.line1": "Press fire to use your weapon.",
  "howto.5.line2": "LASER stuns. FREEZE halts a rival.",
  "howto.5.line3": "BOMB blasts balls away.",
  "howto.5.line4": "HEX, WARP, HEADBUTT extend play.",
  "howto.5.line5": "MISSILE: two shots stun and break",
  "howto.5.line6": "destructible arena blocks. CAT chases!",
  "howto.6.title": "Penalties",
  "howto.6.line1": "Bad pickups hit you or your rivals.",
  "howto.6.line2": "SMALL INV SLOWP BLIND shrink,",
  "howto.6.line3": "flip, slow or hide the table.",
  "howto.6.line4": "TURBO speeds the ball up.",
  "howto.6.line5": "DRUNK sways your paddle. JAM",
  "howto.6.line6": "locks your weapon. CLEAN removes all.",
